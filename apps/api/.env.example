# Local development against `supabase start` and `docker compose up minio`.
# Copy to .env. Production values come from Supabase and Cloudflare R2.
PORT=8787
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# The local stack signs sessions with this shared secret (HS256). Hosted projects use signing keys (JWKS) instead.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=gigacad
S3_ACCESS_KEY_ID=gigacad
S3_SECRET_ACCESS_KEY=gigacad-local-secret
S3_FORCE_PATH_STYLE=true
WEB_ORIGIN=http://localhost:3000
