<Project Sdk="Microsoft.NET.Sdk">
  <!-- The SolidWorks plugin loaded into the GigaCAD app. The add-in inside SolidWorks is a separate net48 project (see docs/WINDOWS_APP_PLAN.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- The app supplies the contracts at run time; don't ship a second copy in the plugin folder. -->
    <ProjectReference Include="..\GigaCAD.Plugins.Abstractions\GigaCAD.Plugins.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GigaCAD.Plugins.Tests" />
  </ItemGroup>
</Project>
